# RabbitMQ配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 大模型配置
BAILIAN_API_KEY=your_api_key_here
BAILIAN_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 向量模型配置
VECTOR_MODEL=bge-m3-base
VECTOR_DIM=768

# 服务配置
SERVICE_NAME=rag-generation-service
LOG_LEVEL=INFO

# 知识图谱服务配置
KNOWLEDGE_GRAPH_SERVICE_URL=http://localhost:8082
KG_CLIENT_TIMEOUT=10.0

# 文档服务配置
DOCUMENT_SERVICE_URL=http://localhost:8081
VECTOR_SERVICE_URL=http://localhost:8084
