<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cxyaqcdm.fta.feedback.mapper.FeedbackMapper">
    <resultMap id="FeedbackResultMap" type="com.cxyaqcdm.fta.feedback.entity.FeedbackEntity">
        <id property="id" column="id"/>
        <result property="treeId" column="tree_id"/>
        <result property="userId" column="user_id"/>
        <result property="feedbackType" column="feedback_type"/>
        <result property="content" column="content"/>
        <result property="suggestions" column="suggestions"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findById" resultMap="FeedbackResultMap">
        SELECT * FROM feedback WHERE id = #{id}
    </select>

    <select id="findByTreeId" resultMap="FeedbackResultMap">
        SELECT * FROM feedback WHERE tree_id = #{treeId}
    </select>

    <select id="findByUserId" resultMap="FeedbackResultMap">
        SELECT * FROM feedback WHERE user_id = #{userId}
    </select>

    <select id="findAll" resultMap="FeedbackResultMap">
        SELECT * FROM feedback
    </select>

    <select id="findTopNByOrderByCreatedAtDesc" resultMap="FeedbackResultMap">
        SELECT * FROM feedback ORDER BY created_at DESC LIMIT #{limit}
    </select>

    <insert id="insert">
        INSERT INTO feedback (id, tree_id, user_id, feedback_type, content, suggestions, created_at)
        VALUES (#{id}, #{treeId}, #{userId}, #{feedbackType}, #{content}, #{suggestions}, #{createdAt})
    </insert>
</mapper>