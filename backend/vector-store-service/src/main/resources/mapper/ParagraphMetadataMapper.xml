<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cxyaqcdm.fta.vector.mapper.ParagraphMetadataMapper">
    <resultMap id="ParagraphMetadataResultMap" type="com.cxyaqcdm.fta.vector.entity.ParagraphMetadata">
        <id property="id" column="id"/>
        <result property="paragraphId" column="paragraph_id"/>
        <result property="docId" column="doc_id"/>
        <result property="sectionTitle" column="section_title"/>
        <result property="pageNumber" column="page_number"/>
        <result property="paragraphNumber" column="paragraph_number"/>
        <result property="textLength" column="text_length"/>
        <result property="keywords" column="keywords"/>
        <result property="confidenceScore" column="confidence_score"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="ParagraphMetadataResultMap">
        SELECT * FROM paragraph_metadata WHERE id = #{id}
    </select>

    <select id="findByParagraphId" resultMap="ParagraphMetadataResultMap">
        SELECT * FROM paragraph_metadata WHERE paragraph_id = #{paragraphId}
    </select>

    <select id="findByDocId" resultMap="ParagraphMetadataResultMap">
        SELECT * FROM paragraph_metadata WHERE doc_id = #{docId}
    </select>

    <insert id="insert">
        INSERT INTO paragraph_metadata (paragraph_id, doc_id, section_title, page_number, paragraph_number, text_length, keywords, confidence_score, content, created_at, updated_at)
        VALUES (#{paragraphId}, #{docId}, #{sectionTitle}, #{pageNumber}, #{paragraphNumber}, #{textLength}, #{keywords}, #{confidenceScore}, #{content}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE paragraph_metadata
        SET section_title = #{sectionTitle}, page_number = #{pageNumber}, paragraph_number = #{paragraphNumber}, 
            text_length = #{textLength}, keywords = #{keywords}, confidence_score = #{confidenceScore}, 
            content = #{content}, updated_at = #{updatedAt}
        WHERE paragraph_id = #{paragraphId}
    </update>

    <delete id="deleteByDocId">
        DELETE FROM paragraph_metadata WHERE doc_id = #{docId}
    </delete>
</mapper>