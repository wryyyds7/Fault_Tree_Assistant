<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cxyaqcdm.fta.vector.mapper.DocumentMetadataMapper">
    <resultMap id="DocumentMetadataResultMap" type="com.cxyaqcdm.fta.vector.entity.DocumentMetadata">
        <id property="id" column="id"/>
        <result property="docId" column="doc_id"/>
        <result property="fileName" column="file_name"/>
        <result property="fileType" column="file_type"/>
        <result property="pageCount" column="page_count"/>
        <result property="uploadTime" column="upload_time"/>
        <result property="equipmentType" column="equipment_type"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="DocumentMetadataResultMap">
        SELECT * FROM document_metadata WHERE id = #{id}
    </select>

    <select id="findByDocId" resultMap="DocumentMetadataResultMap">
        SELECT * FROM document_metadata WHERE doc_id = #{docId}
    </select>

    <select id="findAll" resultMap="DocumentMetadataResultMap">
        SELECT * FROM document_metadata
    </select>

    <insert id="insert">
        INSERT INTO document_metadata (doc_id, file_name, file_type, page_count, upload_time, equipment_type, status, created_at, updated_at)
        VALUES (#{docId}, #{fileName}, #{fileType}, #{pageCount}, #{uploadTime}, #{equipmentType}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE document_metadata
        SET file_name = #{fileName}, file_type = #{fileType}, page_count = #{pageCount}, 
            upload_time = #{uploadTime}, equipment_type = #{equipmentType}, status = #{status}, updated_at = #{updatedAt}
        WHERE doc_id = #{docId}
    </update>

    <delete id="delete">
        DELETE FROM document_metadata WHERE doc_id = #{docId}
    </delete>
</mapper>